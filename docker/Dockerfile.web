# ==============================================================================
# FeastFlow Web Portal Multi-Stage Production Dockerfile
# Monorepo Workspace: apps/web & packages/shared
# Base Image: NGINX Alpine
# ==============================================================================

# Stage 1: Build Vite Single Page Application
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace manifests
COPY package.json package-lock.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY apps/web/package.json ./apps/web/
COPY apps/web/tsconfig.json ./apps/web/
COPY apps/web/vite.config.ts ./apps/web/
COPY apps/web/tailwind.config.js ./apps/web/
COPY apps/web/postcss.config.js ./apps/web/

# Install dependencies
RUN npm ci

# Copy sources
COPY packages/shared/src ./packages/shared/src
COPY apps/web/src ./apps/web/src
COPY apps/web/index.html ./apps/web/

# Build shared package
RUN npm --workspace=@food-delivery/shared run build

# Build-time environment arguments (Overridable during CI/CD build)
ARG VITE_API_URL="/api/v1"
ARG VITE_WS_URL=""

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

# Build Vite application for production
RUN npm --workspace=@food-delivery/web run build

# Stage 2: Production Web Server
FROM nginx:1.25-alpine AS runner

# Remove default nginx HTML files
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static assets from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]

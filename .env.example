# Application Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_delivery_db?schema=public"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (min 16 chars)
JWT_ACCESS_SECRET="your_jwt_access_secret_min_16_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_16_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client Application URLs
FRONTEND_WEB_URL="http://localhost:3000"
MOBILE_APP_URL="exp://localhost:8081"

# Third-Party Integrations (Optional for local development)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MAP_API_KEY=""

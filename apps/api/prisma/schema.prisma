// Prisma Schema for Food Delivery Platform ("FeastFlow")
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USER & AUTHENTICATION MODELS
// ==========================================

enum UserRoleEnum {
  CUSTOMER
  RESTAURANT_OWNER
  DELIVERY_DRIVER
  ADMIN
}

enum AddressTypeEnum {
  HOME
  WORK
  OTHER
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  name            String
  phone           String?     @unique
  avatarUrl       String?
  isEmailVerified Boolean     @default(false)
  isActive        Boolean     @default(true)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  userRoles       UserRole[]
  addresses       Address[]
  restaurants     Restaurant[]       @relation("RestaurantOwner")
  orders          Order[]            @relation("CustomerOrders")
  cart            Cart?
  reviews         Review[]
  favorites       Favorite[]
  notifications   Notification[]
  driverProfile   DeliveryDriver?
  couponUsages    CouponUsage[]
  statusChanges   OrderStatusHistory[] @relation("StatusChangedBy")
  refreshTokens   RefreshToken[]
  deviceTokens    DeviceToken[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        UserRoleEnum @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Address {
  id                   String          @id @default(uuid())
  userId               String
  title                String          @default("Home") // Home, Work, Gym, etc.
  type                 AddressTypeEnum @default(HOME)
  street               String
  apartment            String?
  city                 String
  state                String?
  postalCode           String?
  latitude             Float
  longitude            Float
  deliveryInstructions String?
  isDefault            Boolean         @default(false)
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               Order[]         @relation("OrderDeliveryAddress")

  @@index([userId])
  @@index([latitude, longitude])
  @@map("addresses")
}

// ==========================================
// 2. RESTAURANT & MENU MODELS
// ==========================================

model Restaurant {
  id                      String    @id @default(uuid())
  ownerId                 String
  name                    String
  slug                    String    @unique
  description             String?
  phone                   String
  email                   String?
  logoUrl                 String?
  bannerUrl               String?
  street                  String
  city                    String
  latitude                Float
  longitude               Float
  deliveryRadiusKm        Float     @default(10.0)
  minimumOrderAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  deliveryFeeBase         Decimal   @default(2.50) @db.Decimal(10, 2)
  estimatedDeliveryMin    Int       @default(25)
  estimatedDeliveryMax    Int       @default(45)
  isApproved              Boolean   @default(false)
  isActive                Boolean   @default(true)
  ratingAverage           Decimal   @default(0.00) @db.Decimal(3, 2)
  ratingCount             Int       @default(0)
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  owner                   User                  @relation("RestaurantOwner", fields: [ownerId], references: [id])
  operatingHours          RestaurantHour[]
  categoryLinks           RestaurantCategory[]
  foodCategories          FoodCategory[]
  foodItems               FoodItem[]
  orders                  Order[]
  reviews                 Review[]
  favorites               Favorite[]

  @@index([ownerId])
  @@index([latitude, longitude])
  @@index([isActive, isApproved])
  @@index([ratingAverage])
  @@map("restaurants")
}

model RestaurantHour {
  id           String     @id @default(uuid())
  restaurantId String
  dayOfWeek    Int        // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime     String     // "08:00"
  closeTime    String     // "22:00"
  isClosed     Boolean    @default(false)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("restaurant_hours")
}

model RestaurantCategory {
  id             String       @id @default(uuid())
  restaurantId   String
  foodCategoryId String

  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       FoodCategory @relation(fields: [foodCategoryId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, foodCategoryId])
  @@index([restaurantId])
  @@index([foodCategoryId])
  @@map("restaurant_categories")
}

model FoodCategory {
  id           String               @id @default(uuid())
  restaurantId String?              // If null, it's a global platform category (e.g. "Burgers", "Pizza")
  name         String
  slug         String
  iconUrl      String?
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItems    FoodItem[]
  restaurants  RestaurantCategory[]

  @@index([restaurantId])
  @@index([slug])
  @@map("food_categories")
}

enum OptionSelectionTypeEnum {
  SINGLE
  MULTIPLE
}

model FoodItem {
  id                  String             @id @default(uuid())
  restaurantId        String
  categoryId          String
  name                String
  description         String?
  price               Decimal            @db.Decimal(10, 2)
  imageUrl            String?
  ingredients         String[]           @default([])
  isAvailable         Boolean            @default(true)
  preparationTimeMin  Int                @default(15)
  calories            Int?
  ratingAverage       Decimal            @default(0.00) @db.Decimal(3, 2)
  ratingCount         Int                @default(0)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category            FoodCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options             FoodItemOption[]
  addons              FoodAddon[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reviews             Review[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("food_items")
}

model FoodItemOption {
  id          String                  @id @default(uuid())
  foodItemId  String
  name        String                  // e.g. "Size", "Crust", "Spice Level"
  type        OptionSelectionTypeEnum @default(SINGLE)
  isRequired  Boolean                 @default(false)
  minSelect   Int                     @default(0)
  maxSelect   Int                     @default(1)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  foodItem    FoodItem                @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  addons      FoodAddon[]

  @@index([foodItemId])
  @@map("food_item_options")
}

model FoodAddon {
  id          String          @id @default(uuid())
  foodItemId  String
  optionId    String?         // Optional link to parent option group (e.g. Size -> Large)
  name        String          // e.g. "Extra Cheese", "Gluten-Free Crust"
  price       Decimal         @default(0.00) @db.Decimal(10, 2)
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  foodItem    FoodItem        @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  option      FoodItemOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]
  cartItemAddons  CartItemAddon[]

  @@index([foodItemId])
  @@index([optionId])
  @@map("food_addons")
}

// ==========================================
// 3. CART MODELS
// ==========================================

model Cart {
  id           String     @id @default(uuid())
  userId       String     @unique
  restaurantId String?    // Single restaurant per cart
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id                  String          @id @default(uuid())
  cartId              String
  foodItemId          String
  quantity            Int             @default(1)
  specialInstructions String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  cart                Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItem            FoodItem        @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  addons              CartItemAddon[]

  @@index([cartId])
  @@index([foodItemId])
  @@map("cart_items")
}

model CartItemAddon {
  id          String    @id @default(uuid())
  cartItemId  String
  addonId     String

  cartItem    CartItem  @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  addon       FoodAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, addonId])
  @@index([cartItemId])
  @@index([addonId])
  @@map("cart_item_addons")
}

// ==========================================
// 4. ORDER & FULFILLMENT MODELS
// ==========================================

enum OrderStatusEnum {
  PENDING
  RESTAURANT_ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  DRIVER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  REJECTED
  CANCELLED
}

model Order {
  id                  String          @id @default(uuid())
  orderNumber         String          @unique // e.g. "ORD-1025"
  customerId          String
  restaurantId        String
  deliveryAddressId   String
  status              OrderStatusEnum @default(PENDING)
  subtotal            Decimal         @db.Decimal(10, 2)
  deliveryFee         Decimal         @db.Decimal(10, 2)
  serviceFee          Decimal         @db.Decimal(10, 2)
  discountAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  tipAmount           Decimal         @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal         @db.Decimal(10, 2)
  couponId            String?
  specialInstructions String?
  placedAt            DateTime        @default(now())
  estimatedDeliveryAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  customer            User            @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant          Restaurant      @relation(fields: [restaurantId], references: [id])
  deliveryAddress     Address         @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])
  coupon              Coupon?         @relation(fields: [couponId], references: [id])
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payment             Payment?
  deliveryAssignment  DeliveryAssignment?
  reviews             Review[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id           String           @id @default(uuid())
  orderId      String
  foodItemId   String
  nameSnapshot String           // Frozen snapshot of food item name
  priceSnapshot Decimal         @db.Decimal(10, 2) // Frozen price
  quantity     Int
  subtotal     Decimal          @db.Decimal(10, 2)
  specialNotes String?

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem     FoodItem         @relation(fields: [foodItemId], references: [id])
  addons       OrderItemAddon[]

  @@index([orderId])
  @@index([foodItemId])
  @@map("order_items")
}

model OrderItemAddon {
  id           String    @id @default(uuid())
  orderItemId  String
  addonId      String
  nameSnapshot String    // Frozen addon name
  priceSnapshot Decimal  @db.Decimal(10, 2)

  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon        FoodAddon @relation(fields: [addonId], references: [id])

  @@index([orderItemId])
  @@index([addonId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id          String          @id @default(uuid())
  orderId     String
  status      OrderStatusEnum
  notes       String?
  changedById String?
  createdAt   DateTime        @default(now())

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?           @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("order_status_history")
}

// ==========================================
// 5. PAYMENT MODELS
// ==========================================

enum PaymentMethodEnum {
  COD
  CARD
  ONLINE
}

enum PaymentStatusEnum {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id            String            @id @default(uuid())
  orderId       String            @unique
  userId        String
  amount        Decimal           @db.Decimal(10, 2)
  paymentMethod PaymentMethodEnum @default(COD)
  paymentStatus PaymentStatusEnum @default(PENDING)
  transactionId String?           @unique
  paymentGateway String?          // e.g. "STRIPE", "CASH"
  gatewayPayload Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentStatus])
  @@map("payments")
}

// ==========================================
// 6. DELIVERY DRIVER & FLEET MODELS
// ==========================================

enum VehicleTypeEnum {
  BICYCLE
  MOTORCYCLE
  SCOOTER
  CAR
  VAN
}

enum AssignmentStatusEnum {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  REJECTED
  CANCELLED
}

model DeliveryDriver {
  id               String          @id @default(uuid())
  userId           String          @unique
  vehicleType      VehicleTypeEnum @default(MOTORCYCLE)
  licensePlate     String?
  documentUrl      String?
  isOnline         Boolean         @default(false)
  isVerified       Boolean         @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  ratingAverage    Decimal         @default(5.00) @db.Decimal(3, 2)
  ratingCount      Int             @default(0)
  totalDeliveries  Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations        DriverLocation[]
  assignments      DeliveryAssignment[]

  @@index([isOnline, isVerified])
  @@map("delivery_drivers")
}

model DriverLocation {
  id         String         @id @default(uuid())
  driverId   String
  latitude   Float
  longitude  Float
  bearing    Float?
  speed      Float?
  recordedAt DateTime       @default(now())

  driver     DeliveryDriver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([recordedAt])
  @@map("driver_locations")
}

model DeliveryAssignment {
  id           String               @id @default(uuid())
  orderId      String               @unique
  driverId     String
  status       AssignmentStatusEnum @default(ASSIGNED)
  assignedAt   DateTime             @default(now())
  acceptedAt   DateTime?
  pickedUpAt   DateTime?
  deliveredAt  DateTime?
  driverPayout Decimal              @default(5.00) @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver       DeliveryDriver       @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([status])
  @@map("delivery_assignments")
}

// ==========================================
// 7. COUPONS & PROMOTIONS
// ==========================================

enum CouponDiscountTypeEnum {
  PERCENTAGE
  FIXED
}

model Coupon {
  id              String                 @id @default(uuid())
  code            String                 @unique
  description     String?
  discountType    CouponDiscountTypeEnum @default(PERCENTAGE)
  discountValue   Decimal                @db.Decimal(10, 2)
  minimumAmount   Decimal                @default(0.00) @db.Decimal(10, 2)
  maxDiscount     Decimal?               @db.Decimal(10, 2)
  usageLimit      Int?                   // Total times can be used globally
  perUserLimit    Int                    @default(1)
  usedCount       Int                    @default(0)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  orders          Order[]
  usages          CouponUsage[]

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  usedAt    DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usage")
}

// ==========================================
// 8. FAVORITES, REVIEWS & NOTIFICATIONS
// ==========================================

model Favorite {
  id           String     @id @default(uuid())
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
  @@map("favorites")
}

model Review {
  id           String     @id @default(uuid())
  userId       String
  restaurantId String
  orderId      String
  foodItemId   String?
  rating       Int        // 1 to 5
  comment      String?
  reply        String?    // Restaurant owner response
  repliedAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem     FoodItem?   @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([restaurantId])
  @@index([orderId])
  @@index([foodItemId])
  @@map("reviews")
}

enum NotificationTypeEnum {
  ORDER_UPDATE
  DELIVERY_ALERT
  PROMOTION
  SYSTEM
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationTypeEnum @default(ORDER_UPDATE)
  data      Json?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?  // 'ios', 'android', 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
